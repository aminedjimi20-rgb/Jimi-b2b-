DATABASE_URL="postgresql://jimi:jimi@localhost:5432/jimi_b2b?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000

# Comma-separated list of allowed browser origins (Flutter Web / a future
# admin console). Leave unset for a mobile-only backend — see main.ts.
ALLOWED_ORIGINS=""

# Object storage (produits) — à configurer en Phase 2/3 (swap out the local
# ./uploads disk storage in src/uploads for S3/R2 in production)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Push notifications (FCM) — path to a Firebase service account JSON.
# Leave unset to run without push (in-app notifications keep working).
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Public URL the API is reachable at — used to build the links inside
# verification/password-reset emails (e.g. https://xxx.up.railway.app/api).
PUBLIC_API_URL="http://localhost:3000/api"

# Email sending for account verification / password reset. "log" (default)
# just writes the email content to the server log instead of sending it —
# fully functional for testing, swap in a real provider once you have one
# (see src/mailer/mailer.service.ts).
MAIL_PROVIDER="log"

# Local directory for pg_dump backups (see src/backup). Point this at a
# mounted volume backed by object storage in production.
BACKUP_DIR="./backups"

# First Admin account, created by `npx prisma db seed` (see prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@jimi-b2b.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
