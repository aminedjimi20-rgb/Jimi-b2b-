// JIMI B2B — Database schema (PostgreSQL)
// Source de vérité — voir docs/DATABASE.md pour la description en langage clair.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / Users
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CLIENT
  EMPLOYEE // extension future
  DELIVERY // extension future
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client        Client?
  refreshTokens RefreshToken[]
  notifications Notification[]
  permissions   UserPermission[] // extension future (EMPLOYEE)
  deliveries    Delivery[]       @relation("DeliveryPerson") // extension future

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Permissions granulaires — utilisées seulement pour le rôle EMPLOYEE (extension future)
model UserPermission {
  id     String @id @default(cuid())
  userId String
  key    String // ex: "products.write", "orders.manage", "stats.read"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ─────────────────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  userId         String   @unique
  raisonSociale  String
  telephone      String
  adresse        String?
  ville          String?
  limiteCredit   Decimal  @default(0) @db.Decimal(12, 2)
  soldeCredit    Decimal  @default(0) @db.Decimal(12, 2)
  notesInternes  String? // visible Admin uniquement
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  customPrices        ClientProductPrice[]
  orders              Order[]
  favorites           Favorite[]
  promotions          PromotionClient[]
  payments            Payment[]

  @@index([raisonSociale])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id       String     @id @default(cuid())
  nom      String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([nom, parentId])
}

model Product {
  id            String   @id @default(cuid())
  nom           String
  code          String   @unique
  categoryId    String
  description   String?
  taille        String?
  couleur       String?
  marque        String?
  prixAchat     Decimal  @db.Decimal(12, 2) // ADMIN ONLY — jamais exposé au client
  prixVente     Decimal  @db.Decimal(12, 2)
  stockReel     Int      @default(0) // ADMIN ONLY — client voit un statut dérivé
  stockMinimum  Int      @default(0) // ADMIN ONLY
  minCommande   Int      @default(1)
  actif         Boolean  @default(true)
  imageHash     String? // pHash de l'image principale, pour recherche par image (Phase 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category             @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  priceTiers    PriceTier[]
  customPrices  ClientProductPrice[]
  orderItems    OrderItem[]
  stockMoves    StockMovement[]
  favorites     Favorite[]
  promotions    PromotionProduct[]

  @@index([categoryId])
  @@index([nom])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  hash      String? // pHash pour recherche par image
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Grille de prix par palier de quantité (ex: 1-5, 6-23, 24-99, 100+)
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  qteMin    Int
  qteMax    Int? // null = pas de plafond (ex: "100+")
  prix      Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Prix personnalisé d'un produit pour UN client précis — override total
model ClientProductPrice {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  prix      Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────────────────────────────────

enum PromotionType {
  POURCENTAGE
  MONTANT
}

model Promotion {
  id        String        @id @default(cuid())
  nom       String
  type      PromotionType
  valeur    Decimal       @db.Decimal(12, 2) // % ou montant fixe selon `type`
  dateDebut DateTime
  dateFin   DateTime
  actif     Boolean       @default(true)
  createdAt DateTime      @default(now())

  // Ciblage optionnel — si vide, s'applique à tout le catalogue / tous les clients
  products PromotionProduct[]
  clients  PromotionClient[]

  @@index([dateDebut, dateFin])
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionClient {
  promotionId String
  clientId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([promotionId, clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Commandes
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  PREPARATION
  PRETE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum PaymentMethod {
  ESPECES
  VIREMENT
  BARIDIMOB
  LIVRAISON
  CREDIT
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique // ex: CMD-2026-00001
  clientId        String
  status          OrderStatus   @default(EN_ATTENTE)
  paymentMethod   PaymentMethod
  adresseLivraison String
  telephoneContact String
  total           Decimal       @db.Decimal(12, 2) // calculé serveur, jamais fourni par le client
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client        Client          @relation(fields: [clientId], references: [id])
  items         OrderItem[]
  stockMoves    StockMovement[]
  payments      Payment[]
  delivery      Delivery?

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantite       Int
  prixUnitaire   Decimal @db.Decimal(12, 2) // prix résolu et figé au moment de la commande

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Stock
// ─────────────────────────────────────────────────────────────────────────

enum StockMovementType {
  ENTREE
  SORTIE
  RETOUR
  AJUSTEMENT
  VENTE
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantite    Int // toujours positif ; le sens est donné par `type`
  orderId     String?
  warehouseId String? // extension future multi-dépôt
  motif       String?
  createdAt   DateTime          @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Paiements / Crédit
// ─────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  EN_ATTENTE
  VALIDE
  REJETE
}

model Payment {
  id        String        @id @default(cuid())
  clientId  String
  orderId   String?
  montant   Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(EN_ATTENTE)
  provider  String? // extension future : "baridimob", "stripe", "cib", ...
  createdAt DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications / Favoris
// ─────────────────────────────────────────────────────────────────────────

enum NotificationType {
  NOUVELLE_COMMANDE
  STATUT_COMMANDE
  STOCK_FAIBLE
  PROMOTION
  SYSTEME
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titre     String
  message   String
  lu        Boolean          @default(false)
  data      Json? // ex: { orderId, productId }
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
}

model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Extensions futures (schéma prêt, non utilisé en Phase 1-3)
// ─────────────────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  nom       String
  adresse   String?
  createdAt DateTime @default(now())

  stockMoves StockMovement[]
}

model Delivery {
  id             String    @id @default(cuid())
  orderId        String    @unique
  deliveryUserId String?
  statut         String    @default("EN_ATTENTE")
  dateLivraison  DateTime?

  order        Order @relation(fields: [orderId], references: [id])
  deliveryUser User? @relation("DeliveryPerson", fields: [deliveryUserId], references: [id])
}
