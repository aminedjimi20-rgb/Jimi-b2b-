// JIMI B2B — Database schema (PostgreSQL)
// Source de vérité — voir docs/DATABASE.md pour la description en langage clair.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Compteurs — references séquentielles lisibles (BC-2026-0001, BR-2026-0001, ...)
// ─────────────────────────────────────────────────────────────────────────

model Sequence {
  key   String @id // ex: "BC-2026", "BR-2026" — un compteur par préfixe+année
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / Users
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CLIENT
  EMPLOYEE // extension future
  DELIVERY // extension future
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Email verification / password reset — @default(true) so every account
  // created by an Admin (client/employee onboarding) or that existed before
  // this feature stays fully usable with zero migration side-effects; only
  // the new self-registration flow (register()) explicitly sets this false.
  emailVerified               Boolean   @default(true)
  emailVerificationTokenHash  String?   @unique
  emailVerificationExpiresAt  DateTime?
  passwordResetTokenHash      String?   @unique
  passwordResetExpiresAt      DateTime?

  client        Client?
  employee      Employee?
  refreshTokens RefreshToken[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
  permissions   UserPermission[] // extension future (permissions fines par employé)
  deliveries    Delivery[]       @relation("DeliveryPerson") // extension future

  @@index([role])
}

// Compte employé — accès restreint : jamais prixAchat/marge, jamais les
// commandes/infos des autres clients. Prépare des commandes assignées ou en
// crée au comptoir (qui restent EN_ATTENTE tant que l'Admin ne les confirme pas).
model Employee {
  id        String    @id @default(cuid())
  userId    String    @unique
  nom       String
  telephone String?
  deletedAt DateTime? // corbeille — null = actif
  createdAt DateTime  @default(now())

  // Granular visibility, set by the Admin per employee — off by default (an
  // employee sees neither unless explicitly granted). Enforced server-side
  // in the employee-facing DTOs (see orders/dto, clients/dto), never just
  // hidden in the UI.
  canSeeClientPhone   Boolean @default(false)
  canSeeClientAddress Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Permissions granulaires — utilisées seulement pour le rôle EMPLOYEE (extension future)
model UserPermission {
  id     String @id @default(cuid())
  userId String
  key    String // ex: "products.write", "orders.manage", "stats.read"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ─────────────────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id              String    @id @default(cuid())
  userId          String    @unique
  raisonSociale   String
  telephone       String
  adresse         String?
  ville           String?
  limiteCredit    Decimal   @default(0) @db.Decimal(12, 2)
  soldeCredit     Decimal   @default(0) @db.Decimal(12, 2)
  priceCategoryId String? // catégorie de prix assignée — voir PriceCategory/ProductSalePrice
  notesInternes   String? // visible Admin uniquement
  deletedAt       DateTime? // corbeille — null = actif
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceCategory   PriceCategory?       @relation(fields: [priceCategoryId], references: [id])
  customPrices    ClientProductPrice[]
  orders          Order[]
  favorites       Favorite[]
  promotions      PromotionClient[]
  payments        Payment[]
  productRequests ProductRequest[]

  @@index([raisonSociale])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  nom       String
  parentId  String?
  deletedAt DateTime? // corbeille — null = actif

  // Visibility per role, set by the Admin — default true (visible) so every
  // existing category keeps behaving exactly as before this field existed.
  visibleToClient   Boolean @default(true)
  visibleToEmployee Boolean @default(true)

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@unique([nom, parentId])
  @@index([deletedAt])
}

// Fournisseur/fabricant — d'où vient la marchandise reçue via un StockReceipt.
model Fabricant {
  id        String    @id @default(cuid())
  nom       String
  telephone String?
  adresse   String?
  deletedAt DateTime? // corbeille — null = actif
  createdAt DateTime  @default(now())

  products Product[]
  receipts StockReceipt[]
  payments Payment[]

  @@index([nom])
  @@index([deletedAt])
}

model Product {
  id             String    @id @default(cuid())
  nom            String
  code           String    @unique
  categoryId     String
  fabricantId    String?
  description    String?
  taille         String?
  couleur        String?
  marque         String?
  prixAchat      Decimal   @db.Decimal(12, 2) // ADMIN ONLY — jamais exposé au client
  prixVente      Decimal   @db.Decimal(12, 2)
  stockReel      Int       @default(0) // ADMIN ONLY — client voit un statut dérivé
  stockMinimum   Int       @default(0) // ADMIN ONLY
  minCommande    Int       @default(1)
  uniteParCarton Int? // pratique pour préremplir le prochain bon de réception de ce produit
  actif          Boolean   @default(true) // visibilité catalogue — distinct de deletedAt
  estNouveau     Boolean   @default(false) // badge "Nouveau" — activé/désactivé par l'Admin, visible du client
  estSaisonnier  Boolean   @default(false) // badge "Saisonnier" — activé/désactivé par l'Admin, visible du client
  deletedAt      DateTime? // corbeille — null = actif (peut être true ou false pour `actif`)
  imageHash      String? // pHash de l'image principale, pour recherche par image (Phase 1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category          Category              @relation(fields: [categoryId], references: [id])
  fabricant         Fabricant?            @relation(fields: [fabricantId], references: [id])
  images            ProductImage[]
  priceTiers        PriceTier[]
  customPrices      ClientProductPrice[]
  salePrices        ProductSalePrice[]
  priceHistory      ProductPriceHistory[]
  orderItems        OrderItem[]
  stockMoves        StockMovement[]
  stockReceiptItems StockReceiptItem[]
  favorites         Favorite[]
  promotions        PromotionProduct[]

  @@index([categoryId])
  @@index([fabricantId])
  @@index([nom])
  @@index([deletedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  hash      String? // pHash pour recherche par image
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Grille de prix par palier de quantité (ex: 1-5, 6-23, 24-99, 100+)
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  qteMin    Int
  qteMax    Int? // null = pas de plafond (ex: "100+")
  prix      Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Prix personnalisé d'un produit pour UN client précis — override total
model ClientProductPrice {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  prix      Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
}

// Catégorie de prix (ex: "Gros", "Détail", "VIP") — un client est assigné à
// une catégorie et paie automatiquement le prix défini pour cette catégorie
// sur chaque produit (voir ProductSalePrice), sans configuration par client.
model PriceCategory {
  id        String   @id @default(cuid())
  nom       String   @unique
  createdAt DateTime @default(now())

  salePrices ProductSalePrice[]
  clients    Client[]
}

// Prix de vente d'UN produit pour UNE catégorie de prix — "Prix de vente 1/2/3...".
model ProductSalePrice {
  id              String  @id @default(cuid())
  productId       String
  priceCategoryId String
  prix            Decimal @db.Decimal(12, 2)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCategory PriceCategory @relation(fields: [priceCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, priceCategoryId])
  @@index([productId])
}

// Instantané prixAchat/prixVente à chaque changement — permet d'afficher
// "dernier changement de prix" et un badge "Nouveau prix" sur la fiche produit.
model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  prixAchat Decimal  @db.Decimal(12, 2)
  prixVente Decimal  @db.Decimal(12, 2)
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────────────────────────────────

enum PromotionType {
  POURCENTAGE
  MONTANT
}

model Promotion {
  id        String        @id @default(cuid())
  nom       String
  type      PromotionType
  valeur    Decimal       @db.Decimal(12, 2) // % ou montant fixe selon `type`
  dateDebut DateTime
  dateFin   DateTime
  actif     Boolean       @default(true)
  createdAt DateTime      @default(now())

  // Ciblage optionnel — si vide, s'applique à tout le catalogue / tous les clients
  products PromotionProduct[]
  clients  PromotionClient[]

  @@index([dateDebut, dateFin])
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionClient {
  promotionId String
  clientId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([promotionId, clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Transport / livraison
// ─────────────────────────────────────────────────────────────────────────

// Transporteur (société ou personne qui livre) — géré par l'Admin, sert de
// base au tarif par destination (DeliveryRate) sélectionnable sur une commande.
model Transporteur {
  id        String    @id @default(cuid())
  nom       String
  deletedAt DateTime? // corbeille — null = actif
  createdAt DateTime  @default(now())

  rates  DeliveryRate[]
  orders Order[]

  @@index([nom])
  @@index([deletedAt])
}

// Tarif de livraison d'UN transporteur vers UNE destination — préremplit
// automatiquement fraisLivraison quand l'Admin choisit transporteur+destination.
model DeliveryRate {
  id             String  @id @default(cuid())
  transporteurId String
  destination    String
  prix           Decimal @db.Decimal(12, 2)

  transporteur Transporteur @relation(fields: [transporteurId], references: [id], onDelete: Cascade)

  @@unique([transporteurId, destination])
  @@index([transporteurId])
}

// ─────────────────────────────────────────────────────────────────────────
// Commandes
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  PREPARATION
  PRETE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum PaymentMethod {
  ESPECES
  VIREMENT
  BARIDIMOB
  LIVRAISON
  CREDIT
}

model Order {
  id                String        @id @default(cuid())
  reference         String        @unique // ex: BC-2026-0001 (bon client)
  nom               String? // libellé libre pour retrouver la commande facilement
  clientId          String
  status            OrderStatus   @default(EN_ATTENTE)
  paymentMethod     PaymentMethod
  adresseLivraison  String
  telephoneContact  String
  total             Decimal       @db.Decimal(12, 2) // sous-total après remise + fraisLivraison — calculé serveur
  remisePourcentage Decimal?      @db.Decimal(5, 2) // remise ADMIN uniquement — jamais pilotable par le client
  fraisLivraison    Decimal       @default(0) @db.Decimal(12, 2) // ADMIN uniquement, affiché séparément dans le bon
  transporteurId    String? // optionnel — voir Transporteur/DeliveryRate
  destination       String? // ville/zone de livraison, pour l'historique et le tarif
  employeeId        String? // employé assigné pour la préparation — voir Employee
  montantPaye       Decimal       @default(0) @db.Decimal(12, 2) // somme des Payment liés — statut dérivé (voir order-response.dto)
  deletedAt         DateTime? // corbeille — null = actif
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client       Client          @relation(fields: [clientId], references: [id])
  transporteur Transporteur?   @relation(fields: [transporteurId], references: [id])
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  items        OrderItem[]
  stockMoves   StockMovement[]
  payments     Payment[]
  delivery     Delivery?

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(12, 2) // prix résolu et figé au moment de la commande

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Stock
// ─────────────────────────────────────────────────────────────────────────

enum StockMovementType {
  ENTREE
  SORTIE
  RETOUR
  AJUSTEMENT
  VENTE
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  type           StockMovementType
  quantite       Int // toujours positif ; le sens est donné par `type`
  orderId        String?
  stockReceiptId String?
  warehouseId    String? // extension future multi-dépôt
  motif          String?
  createdAt      DateTime          @default(now())

  product      Product       @relation(fields: [productId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  stockReceipt StockReceipt? @relation(fields: [stockReceiptId], references: [id])
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@index([productId])
}

// Bon de réception — marchandise reçue d'un Fabricant. Chaque ligne crée un
// StockMovement ENTREE (traçabilité), et garde un instantané des cartons /
// unités par carton / prix vente au moment de la réception pour le PDF.
model StockReceipt {
  id          String    @id @default(cuid())
  reference   String    @unique // ex: BR-2026-0001
  fabricantId String
  total       Decimal   @db.Decimal(12, 2) // total au prix de vente — calculé serveur
  totalAchat  Decimal   @default(0) @db.Decimal(12, 2) // total au prix d'achat — ce que ça a réellement coûté (= ce qui est dû au fournisseur)
  montantPaye Decimal   @default(0) @db.Decimal(12, 2) // somme des Payment liés — statut dérivé (voir stock-receipt-response.dto)
  notes       String?
  deletedAt   DateTime? // corbeille — null = actif
  createdAt   DateTime  @default(now())

  fabricant  Fabricant          @relation(fields: [fabricantId], references: [id])
  items      StockReceiptItem[]
  stockMoves StockMovement[]
  payments   Payment[]

  @@index([fabricantId])
  @@index([deletedAt])
}

model StockReceiptItem {
  id              String  @id @default(cuid())
  stockReceiptId  String
  productId       String
  cartons         Int
  unitesParCarton Int
  quantite        Int // = cartons * unitesParCarton, figé pour l'historique
  prixAchat       Decimal @default(0) @db.Decimal(12, 2) // instantané — ce que ce produit a coûté à la réception
  prixVente       Decimal @db.Decimal(12, 2) // instantané au moment de la réception

  stockReceipt StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([stockReceiptId])
}

// ─────────────────────────────────────────────────────────────────────────
// Paiements / Crédit
// ─────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  EN_ATTENTE
  VALIDE
  REJETE
}

// Money ledger in BOTH directions — money IN from a Client (clientId set,
// orderId optional) or money OUT to a Fabricant (fabricantId set,
// stockReceiptId optional). Exactly one of clientId/fabricantId is set,
// enforced in PaymentsService (not expressible as a Prisma-level constraint).
model Payment {
  id             String        @id @default(cuid())
  clientId       String?
  orderId        String?
  fabricantId    String?
  stockReceiptId String?
  montant        Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(EN_ATTENTE)
  provider       String? // extension future : "baridimob", "stripe", "cib", ...
  createdAt      DateTime      @default(now())

  // Restrict (not the Prisma default of SetNull for optional relations): a
  // Payment is real financial history — permanently deleting the client/
  // order/fournisseur/bon it belongs to must never silently sever that link.
  // The corbeille's "supprimer définitivement" is correctly blocked instead
  // (see runOrExplainForeignKeyError) until there's nothing left to protect.
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fabricant    Fabricant?    @relation(fields: [fabricantId], references: [id], onDelete: Restrict)
  stockReceipt StockReceipt? @relation(fields: [stockReceiptId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([fabricantId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications / Favoris
// ─────────────────────────────────────────────────────────────────────────

enum NotificationType {
  NOUVELLE_COMMANDE
  STATUT_COMMANDE
  STOCK_FAIBLE
  PROMOTION
  SYSTEME
  DEMANDE_PRODUIT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titre     String
  message   String
  lu        Boolean          @default(false)
  data      Json? // ex: { orderId, productId }
  deletedAt DateTime? // corbeille — null = active
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@index([userId, deletedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
}

enum ProductRequestStatus {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

// A client, unable to find a product in the catalog, submits a photo (and
// an optional description) asking the Admin to source/add it — see spec
// point "Demander un produit par photo". Admin reviews and closes it out
// with a status + an optional note back to the client.
model ProductRequest {
  id          String               @id @default(cuid())
  clientId    String
  imageUrl    String
  description String?
  status      ProductRequestStatus @default(EN_ATTENTE)
  adminNote   String?
  deletedAt   DateTime? // corbeille — null = actif
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// FCM push tokens — a user can be logged in on several devices at once.
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Extensions futures (schéma prêt, non utilisé en Phase 1-3)
// ─────────────────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  nom       String
  adresse   String?
  createdAt DateTime @default(now())

  stockMoves StockMovement[]
}

model Delivery {
  id             String    @id @default(cuid())
  orderId        String    @unique
  deliveryUserId String?
  statut         String    @default("EN_ATTENTE")
  dateLivraison  DateTime?

  order        Order @relation(fields: [orderId], references: [id])
  deliveryUser User? @relation("DeliveryPerson", fields: [deliveryUserId], references: [id])
}
