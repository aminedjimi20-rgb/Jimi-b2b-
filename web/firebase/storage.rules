rules_version = '2';

// Photos/videos are uploaded directly from the browser (no server in the
// path, so large videos never hit Vercel's request-body limits) using only
// the public Firebase client config — there is no seller/buyer login to
// require here. What actually protects the bucket is this file: uploads are
// restricted to the machines/ prefix, to image/video content types, and to
// sane size limits. Reads are public because these are marketing photos for
// machines Jimi has already approved for the public site — never seller or
// buyer contact information, which lives only in Firestore (denied to
// clients entirely, see firestore.rules) and is never written to Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /machines/photos/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /machines/videos/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 200 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
