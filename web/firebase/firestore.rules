rules_version = '2';

// Deny all direct client access. Every read/write of machines, sellers,
// buyers, leads, and machineLeads happens through our own Next.js API
// routes using the Firebase Admin SDK (a service account, configured via
// FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY),
// which bypasses these rules entirely. This is what makes seller and buyer
// private data actually private at the database level: even if a browser
// somehow obtained the Firebase client config, it could never read or
// write these collections directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
