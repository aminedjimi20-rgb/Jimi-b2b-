# Copiez ce fichier vers .env.local si vous voulez surcharger les valeurs.
# Toutes ces variables sont optionnelles : les vraies coordonnées de Jimi
# Renovation & Installation sont déjà utilisées par défaut dans
# config/site.config.ts, même sans fichier .env.local.

# Numéro WhatsApp principal, au format international sans "+" ni espaces
# (utilisé par tous les boutons WhatsApp du site)
NEXT_PUBLIC_WHATSAPP_NUMBER=213654486224

# Téléphone principal affiché sur le site (format libre)
NEXT_PUBLIC_PHONE_DISPLAY=+213 654 486 224

# Téléphone principal utilisé dans les liens "tel:" (format E.164)
NEXT_PUBLIC_PHONE_HREF=+213654486224

# Second numéro WhatsApp/téléphone (affiché en complément sur la page Contact et le footer)
NEXT_PUBLIC_WHATSAPP_NUMBER_2=213777168962
NEXT_PUBLIC_PHONE_DISPLAY_2=+213 777 168 962
NEXT_PUBLIC_PHONE_HREF_2=+213777168962

# Adresse email de contact affichée sur le site
NEXT_PUBLIC_EMAIL=aminedjimi20@gmail.com

# URL publique du site (utilisée pour le SEO : sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.dz

# Mot de passe du tableau de bord admin (/admin) — À DÉFINIR avant la mise en production.
# Valeur par défaut si absent : jimi-admin-2026 (NE PAS utiliser en production)
ADMIN_PASSWORD=changez-moi

# Clé secrète utilisée pour signer la session admin — générez une chaîne aléatoire longue.
ADMIN_SESSION_SECRET=changez-moi-aussi

# --- Base de données (Firebase Firestore) -----------------------------------
# OBLIGATOIRE en production : sans ces variables, les machines/leads/vendeurs/
# acheteurs sont stockés dans un dossier temporaire du serveur qui n'est PAS
# partagé entre les différentes instances serverless de Vercel — c'est cette
# absence de configuration qui causait la disparition des machines après
# Approve. Fonctionne sur le plan gratuit Firebase (Spark), aucune carte
# bancaire requise. Voir web/firebase/README.md pour la procédure complète
# (créer un projet Firebase, activer Firestore, publier firestore.rules,
# générer une clé de compte de service).

# Côté serveur uniquement (jamais envoyées au navigateur) — depuis Firebase
# Console → Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=votre-projet-firebase
FIREBASE_CLIENT_EMAIL=xxxx@votre-projet.iam.gserviceaccount.com
# Collez la valeur "private_key" du fichier JSON telle quelle (avec les \n) :
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Stockage des photos/vidéos (Cloudinary) --------------------------------
# OBLIGATOIRE pour que l'upload de photos/vidéos fonctionne. Gratuit, AUCUNE
# carte bancaire requise à l'inscription (contrairement à Firebase Storage,
# qui exige le plan payant Blaze). Voir web/cloudinary/README.md pour la
# procédure (créer un compte sur cloudinary.com, créer un "upload preset"
# non signé). Ces 2 valeurs sont publiques par conception — c'est le preset,
# configuré côté Cloudinary, qui limite dossier/taille/format autorisés.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=jimi_machines

# --- Assistant IA commercial (Claude / Anthropic) ---------------------------
# OBLIGATOIRE pour que l'assistant IA (testeur admin + réponses WhatsApp)
# fonctionne. Créez une clé sur console.anthropic.com. Sans cette variable,
# le testeur IA dans /admin affiche une erreur claire au lieu de planter.
ANTHROPIC_API_KEY=sk-ant-xxxx
# Fournisseur IA utilisé — "anthropic" est le seul supporté actuellement.
# Prévu pour changer de fournisseur plus tard sans toucher au code agent.
AI_PROVIDER=anthropic

# --- WhatsApp Business Platform (Cloud API — Meta) --------------------------
# LAISSEZ VIDE tant que vous n'avez pas configuré votre compte Meta Business.
# Le webhook /api/whatsapp/webhook reste désactivé (503) sans ces 4 valeurs —
# aucun risque à les laisser vides, aucune migration de numéro n'est faite
# automatiquement. Voir Meta for Developers → WhatsApp → Configuration API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Chaîne secrète de votre choix, à saisir aussi côté Meta lors de la
# configuration du webhook (vérification de l'URL).
WHATSAPP_VERIFY_TOKEN=

# Numéro WhatsApp personnel de l'admin (format international sans "+", ex.
# 213777168962) qui reçoit une alerte automatique quand une nouvelle
# conversation démarre, qu'un lead devient HOT, ou qu'une intervention
# humaine est requise — pour être notifié sans avoir le dashboard ouvert.
# Laissez vide pour désactiver ces alertes.
ADMIN_ALERT_PHONE=
