# Copiez ce fichier vers .env.local si vous voulez surcharger les valeurs.
# Toutes ces variables sont optionnelles : les vraies coordonnées de Jimi
# Renovation & Installation sont déjà utilisées par défaut dans
# config/site.config.ts, même sans fichier .env.local.

# Numéro WhatsApp principal, au format international sans "+" ni espaces
# (utilisé par tous les boutons WhatsApp du site)
NEXT_PUBLIC_WHATSAPP_NUMBER=213654486224

# Téléphone principal affiché sur le site (format libre)
NEXT_PUBLIC_PHONE_DISPLAY=+213 654 486 224

# Téléphone principal utilisé dans les liens "tel:" (format E.164)
NEXT_PUBLIC_PHONE_HREF=+213654486224

# Second numéro WhatsApp/téléphone (affiché en complément sur la page Contact et le footer)
NEXT_PUBLIC_WHATSAPP_NUMBER_2=213777168962
NEXT_PUBLIC_PHONE_DISPLAY_2=+213 777 168 962
NEXT_PUBLIC_PHONE_HREF_2=+213777168962

# Adresse email de contact affichée sur le site
NEXT_PUBLIC_EMAIL=aminedjimi20@gmail.com

# URL publique du site (utilisée pour le SEO : sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.dz

# Mot de passe du tableau de bord admin (/admin) — À DÉFINIR avant la mise en production.
# Valeur par défaut si absent : jimi-admin-2026 (NE PAS utiliser en production)
ADMIN_PASSWORD=changez-moi

# Clé secrète utilisée pour signer la session admin — générez une chaîne aléatoire longue.
ADMIN_SESSION_SECRET=changez-moi-aussi

# --- Base de données et stockage (Firebase) ---------------------------------
# OBLIGATOIRE en production : sans ces variables, les machines/leads/vendeurs/
# acheteurs sont stockés dans un dossier temporaire du serveur qui n'est PAS
# partagé entre les différentes instances serverless de Vercel — c'est cette
# absence de configuration qui causait la disparition des machines après
# Approve. Voir web/firebase/README.md pour la procédure complète de mise
# en place (créer un projet Firebase, activer Firestore + Storage, publier
# firestore.rules et storage.rules, générer une clé de compte de service).

# Côté serveur uniquement (jamais envoyées au navigateur) — depuis Firebase
# Console → Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=votre-projet-firebase
FIREBASE_CLIENT_EMAIL=xxxx@votre-projet.iam.gserviceaccount.com
# Collez la valeur "private_key" du fichier JSON telle quelle (avec les \n) :
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Côté navigateur (valeurs publiques, sans risque) — depuis Firebase Console
# → Project Settings → General → Vos applications → configuration SDK.
# Nécessaires pour l'upload de photos/vidéos directement depuis le téléphone
# du vendeur vers Firebase Storage.
NEXT_PUBLIC_FIREBASE_API_KEY=votre-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet-firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet-firebase.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxx:web:xxxx
